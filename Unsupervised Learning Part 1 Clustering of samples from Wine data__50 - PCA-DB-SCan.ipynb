import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns

from sklearn.datasets import load_wine, make_blobs
from sklearn.preprocessing import StandardScaler
from sklearn.decomposition import PCA
from sklearn.cluster import KMeans  # Use KMeans instead of DBSCAN
from sklearn.metrics import silhouette_score, davies_bouldin_score

# --- Wine Dataset ---
wine = load_wine()
wine_data = pd.DataFrame(wine.data, columns=wine.feature_names)
wine_target = wine.target

scaler = StandardScaler()
wine_data_ss = scaler.fit_transform(wine_data)

pca = PCA(n_components=2)
wine_data_pca = pca.fit_transform(wine_data_ss)

plt.figure(figsize=(8, 6))
sns.scatterplot(x=wine_data_pca[:, 0], y=wine_data_pca[:, 1], hue=wine_target, palette="Set1")
plt.title("Wine Dataset PCA (2 Components)")
plt.xlabel("Principal Component 1")
plt.ylabel("Principal Component 2")
plt.show()

# --- Make Blobs Dataset and KMeans ---
X, y = make_blobs(n_samples=200, n_features=2, centers=3, cluster_std=1, random_state=18)

X_ss = scaler.fit_transform(X)

# Find optimal number of clusters (k) for KMeans using Silhouette Score
silhouette_scores = []
davies_bouldin_scores = []
k_range = range(2, 11)  # Test a range of k values (adjust as needed)

for k in k_range:
    kmeans = KMeans(n_clusters=k, random_state=42, n_init=10) # Set n_init to avoid warnings
    cluster_labels = kmeans.fit_predict(X_ss)
    silhouette = silhouette_score(X_ss, cluster_labels)
    davies_bouldin = davies_bouldin_score(X_ss, cluster_labels)
    silhouette_scores.append(silhouette)
    davies_bouldin_scores.append(davies_bouldin)

# Plot Silhouette Scores
plt.figure(figsize=(8, 6))
plt.plot(k_range, silhouette_scores, marker='o')
plt.xlabel("Number of Clusters (k)")
plt.ylabel("Silhouette Score")
plt.title("Silhouette Score vs. Number of Clusters")
plt.show()

# Plot Davies-Bouldin Scores
plt.figure(figsize=(8, 6))
plt.plot(k_range, davies_bouldin_scores, marker='o')
plt.xlabel("Number of Clusters (k)")
plt.ylabel("Davies-Bouldin Score")
plt.title("Davies-Bouldin Score vs. Number of Clusters")
plt.show()

# Choose optimal k based on the plots (you'll have to visually inspect)
optimal_k = 3 # Example, change based on the plots

# Apply KMeans with optimal k
kmeans = KMeans(n_clusters=optimal_k, random_state=42, n_init=10) # Set n_init to avoid warnings
cluster_labels = kmeans.fit_predict(X_ss)

# Visualize KMeans results
plt.figure(figsize=(8, 6))
sns.scatterplot(x=X_ss[:, 0], y=X_ss[:, 1], hue=cluster_labels, palette="Set1")
plt.title(f"Make Blobs KMeans (k={optimal_k})")
plt.xlabel("Feature 1 (Standardized)")
plt.ylabel("Feature 2 (Standardized)")
plt.show()

# Evaluate KMeans (Silhouette Score and Davies-Bouldin Score)
silhouette = silhouette_score(X_ss, cluster_labels)
davies_bouldin = davies_bouldin_score(X_ss, cluster_labels)
print(f"Silhouette Score: {silhouette}")
print(f"Davies-Bouldin Score: {davies_bouldin}")

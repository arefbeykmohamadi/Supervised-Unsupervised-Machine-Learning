import os
import numpy as np
import matplotlib.pyplot as plt
from sklearn.decomposition import FastICA

data_pure = []
data_mix = []

clip = 300  # clip off noisy far end of spectrum

for file in os.listdir():
    if file.lower().endswith('pure.csv'):
        data_pure.append(np.genfromtxt(file, delimiter=',')[clip:, 1])
        wn = np.genfromtxt(file, delimiter=',')[clip:, 0]

    elif file.lower().endswith('csv') and file.lower().startswith('mix'):
        data_mix.append(np.genfromtxt(file, delimiter=',')[clip:, 1])

data_array_pure = np.vstack(data_pure).T
data_array_mix = np.vstack(data_mix).T

S_pure = np.ndarray.astype(data_array_pure, float)  # recast strings as floats
S_mix = np.ndarray.astype(data_array_mix, float)  # recast strings as floats

n_components = 4  # Or however many components you're using. Make this a variable!
ica = FastICA(n_components=n_components, random_state=42)
S_fit = ica.fit_transform(S_mix)

# Plotting all extracted components
fig, axes = plt.subplots(n_components, 2, figsize=(12, 6 * n_components))  # Adjust figure size dynamically

for i in range(n_components):
    # Extracted Components
    axes[i, 0].plot(wn, S_fit[:, i])
    axes[i, 0].set_xlabel('Wavenumbers, cm$^{-1}$')
    axes[i, 0].set_title(f'Extracted Component {i+1} Spectrum')
    axes[i, 0].invert_xaxis()
    axes[i, 0].set_ylabel('Intensity')  # Add y-label for consistency

    # Corresponding Pure Spectra (if available)
    if S_pure.shape[1] > i:  # Check if there's a corresponding pure spectrum
        axes[i, 1].plot(wn, S_pure[:, i])
        axes[i, 1].set_xlabel('Wavenumbers, cm$^{-1}$')
        axes[i, 1].set_ylabel('Transmittance, %')
        axes[i, 1].set_title(f'Pure Component {i+1} Spectrum')
        axes[i, 1].invert_xaxis()


plt.tight_layout()
plt.show()
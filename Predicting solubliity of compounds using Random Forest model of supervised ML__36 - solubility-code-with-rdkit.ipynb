from rdkit import Chem
from rdkit.Chem import Descriptors
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
from sklearn.model_selection import train_test_split, GridSearchCV
from sklearn.ensemble import RandomForestRegressor
from sklearn.metrics import mean_squared_error, r2_score, mean_absolute_error
from sklearn.preprocessing import StandardScaler
from sklearn.decomposition import PCA

def compute_descriptors(smiles):
  mol = Chem.MolFromSmiles(smiles)
  if mol:
    return {
        'MolWt': Descriptors.MolWt(mol),
        'MolLogP': Descriptors.MolLogP(mol),
        'NumHDonors': Descriptors.NumHDonors(mol),
        'NumHAcceptors': Descriptors.NumHAcceptors(mol),
    }
  return None
 
data = pd.read_csv('delaney-processed.csv').drop_duplicates().dropna()
descriptors = data['smiles'].apply(compute_descriptors).dropna()
features = pd.DataFrame(descriptors.tolist())
x,y = features, data['measured log solubility in mols per litre']

x_train, x_test, y_train, y_test = train_test_split(x, y, test_size=0.2, random_state=42)

param_grid = {
    'n_estimators': [100, 200, 300],
    'max_depth': [None, 10, 20, 30],
    'min_samples_split': [2, 5, 10]}
grid_search = GridSearchCV(RandomForestRegressor(random_state=42), param_grid, cv=5)
grid_search.fit(x_train, y_train)
best_model = grid_search.best_estimator_

y_pred = best_model.predict(x_test)
mae = mean_absolute_error(y_test, y_pred)
mse = mean_squared_error(y_test, y_pred)
r2 = r2_score(y_test, y_pred)
rmse = np.sqrt(mse)

print(f'Optimized Mean Absolute Error: {mae:.4f}')
print(f'Optimized Mean Squared Error: {mse:.4f}')
print(f'Optimized R^2 Score: {r2:.4f}')
print(f'Optimized RMSE: {rmse:.4f}')

fig, axes = plt.subplots(1, 3, figsize=(18,6)) 
axes[0].bar(x.columns, best_model.feature_importances_, color='skyblue')
axes[0].set_title('Feature Importance in Solubility Prediction')
axes[0].set_ylabel('Importance')
axes[0].set_xlabel('Features')

axes[1].scatter(y_test, y_pred, color='red', alpha=0.6, label = 'Predicted')
axes[1].plot([y_test.min(), y_test.max()], [y_test.min(), y_test.max()], 'k--', label = 'ideal prdiction(y=x)')
axes[1].set_title('Actual vs Predicted Solubility')
axes[1].set_xlabel('Actual Solubility')
axes[1].set_ylabel('Predicted Solubility')
axes[1].legend()


residuals = y_test - y_pred
axes[2].hist(residuals, bins=20, color='green', alpha=0.7)
axes[2].set_title('Distribution of Prediction Residuals')
axes[2].set_xlabel('Residuals(Actual-Predicted)')
axes[2].set_ylabel('Frequency')

plt.tight_layout()
plt.show()

print('Best Hyperparameters')
print(grid_search.best_params_)
import pandas as pd
import numpy as np
from sklearn.model_selection import train_test_split
from sklearn.ensemble import RandomForestClassifier
from sklearn.metrics import confusion_matrix, classification_report
import matplotlib.pyplot as plt
import seaborn as sns

# 1. Load Data (replace with your actual path)
compound_data = pd.read_csv('organic_compound.csv')  # Changed variable name

# 2. Separate Target and Features
classification_target = compound_data['FG_class']  # Changed variable name
feature_matrix = compound_data.drop('FG_class', axis=1)  # Changed variable name

# 3. Split Data into Training and Testing Sets
X_train_compounds, X_test_compounds, y_train_classes, y_test_classes = train_test_split(
    feature_matrix, classification_target, test_size=0.25, random_state=18
)  # Changed variable names

# 4. Initialize and Train the Random Forest Classifier
compound_classifier = RandomForestClassifier()  # Changed variable name
compound_classifier.fit(X_train_compounds, y_train_classes)  # Changed variable names

# 5. Make Predictions on the Test Set
predicted_classes = compound_classifier.predict(X_test_compounds)  # Changed variable names

# 6. Evaluate the Model (Accuracy)
accuracy = compound_classifier.score(X_test_compounds, y_test_classes)  # Changed variable names
print(f"Accuracy: {accuracy}")

# 7. Confusion Matrix
confusion_mat = confusion_matrix(y_test_classes, predicted_classes)  # Changed variable names

# 8. Plot the Confusion Matrix
plt.figure(figsize=(8, 6))
sns.heatmap(confusion_mat, annot=True, cmap='Blues', fmt='d',
            xticklabels=np.unique(classification_target), # Added labels for x axis
            yticklabels=np.unique(classification_target)) # Added labels for y axis
plt.xlabel('Predicted Value')
plt.ylabel('True Value')
plt.title('Confusion Matrix')  # Added title
plt.show()

# 9. Classification Report (More Detailed Evaluation)
class_report = classification_report(y_test_classes, predicted_classes) # Changed variable names
print("Classification Report:\n", class_report)


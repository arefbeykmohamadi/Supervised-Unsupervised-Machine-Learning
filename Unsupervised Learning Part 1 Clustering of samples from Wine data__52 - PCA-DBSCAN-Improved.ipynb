import pandas as pd
import numpy as np
from sklearn.model_selection import train_test_split
from sklearn.ensemble import RandomForestClassifier
from sklearn.datasets import make_blobs, load_wine
from sklearn.metrics import confusion_matrix, classification_report, silhouette_score, davies_bouldin_score
import matplotlib.pyplot as plt
import seaborn as sns
from sklearn.preprocessing import StandardScaler
from sklearn.decomposition import PCA
from sklearn.cluster import KMeans

# --- 1. Organic Compound Classification (Random Forest) ---
try:
    compound_data = pd.read_csv('organic_compound.csv')
    classification_target = compound_data['FG_class']
    feature_matrix = compound_data.drop('FG_class', axis=1)

    X_train_compounds, X_test_compounds, y_train_classes, y_test_classes = train_test_split(
        feature_matrix, classification_target, test_size=0.25, random_state=18
    )

    compound_classifier = RandomForestClassifier(random_state=18)  # Set random_state for reproducibility
    compound_classifier.fit(X_train_compounds, y_train_classes)

    predicted_classes = compound_classifier.predict(X_test_compounds)

    accuracy = compound_classifier.score(X_test_compounds, y_test_classes)
    print(f"Random Forest Accuracy: {accuracy}")

    confusion_mat = confusion_matrix(y_test_classes, predicted_classes)

    plt.figure(figsize=(8, 6))
    sns.heatmap(confusion_mat, annot=True, cmap='Blues', fmt='d',
                xticklabels=np.unique(classification_target),
                yticklabels=np.unique(classification_target))
    plt.xlabel('Predicted Value')
    plt.ylabel('True Value')
    plt.title('Confusion Matrix (Random Forest)')
    plt.show()

    class_report = classification_report(y_test_classes, predicted_classes)
    print("Classification Report (Random Forest):\n", class_report)

except FileNotFoundError:
    print("organic_compound.csv not found. Skipping Random Forest.")
except KeyError:
    print("FG_class column not found in CSV. Skipping Random Forest.")
except Exception as e:
    print(f"An error occurred during Random Forest training: {e}")


# --- 2. Wine Dataset Analysis (PCA) ---
wine = load_wine()
wine_data = pd.DataFrame(wine.data, columns=wine.feature_names)
wine_target = wine.target

scaler = StandardScaler()
wine_data_ss = scaler.fit_transform(wine_data)

pca = PCA(n_components=2)
wine_data_pca = pca.fit_transform(wine_data_ss)

plt.figure(figsize=(8, 6))
sns.scatterplot(x=wine_data_pca[:, 0], y=wine_data_pca[:, 1], hue=wine_target, palette="Set1")
plt.title("Wine Dataset PCA (2 Components)")
plt.xlabel("Principal Component 1")
plt.ylabel("Principal Component 2")
plt.show()

# --- 3. Make Blobs Dataset Clustering (KMeans) ---
X, y = make_blobs(n_samples=200, n_features=2, centers=3, cluster_std=1, random_state=18)

scaler_blobs = StandardScaler()  # Create a separate scaler for make_blobs data
X_ss = scaler_blobs.fit_transform(X)

# Find optimal number of clusters (k) for KMeans using Silhouette Score and Davies-Bouldin Index
silhouette_scores = []
davies_bouldin_scores = []
k_range = range(2, 11)

for k in k_range:
    kmeans = KMeans(n_clusters=k, random_state=42, n_init=10)
    cluster_labels = kmeans.fit_predict(X_ss)
    silhouette = silhouette_score(X_ss, cluster_labels)
    davies_bouldin = davies_bouldin_score(X_ss, cluster_labels)
    silhouette_scores.append(silhouette)
    davies_bouldin_scores.append(davies_bouldin)

# Plot Silhouette and Davies-Bouldin Scores in one figure
plt.figure(figsize=(12, 5))  # Adjust figure size for better layout

plt.subplot(1, 2, 1)  # Subplot for Silhouette Score
plt.plot(k_range, silhouette_scores, marker='o')
plt.xlabel("Number of Clusters (k)")
plt.ylabel("Silhouette Score")
plt.title("Silhouette Score vs. Number of Clusters")

plt.subplot(1, 2, 2)  # Subplot for Davies-Bouldin Index
plt.plot(k_range, davies_bouldin_scores, marker='o')
plt.xlabel("Number of Clusters (k)")
plt.ylabel("Davies-Bouldin Score")
plt.title("Davies-Bouldin Score vs. Number of Clusters")

plt.tight_layout()  # Adjust subplot params for a tight layout
plt.show()

# Choose optimal k based on the plots (you'll have to visually inspect)
optimal_k = 3  # Example, change based on the plots

# Apply KMeans with optimal k
kmeans = KMeans(n_clusters=optimal_k, random_state=42, n_init=10)
cluster_labels = kmeans.fit_predict(X_ss)

# Visualize KMeans results
plt.figure(figsize=(8, 6))
sns.scatterplot(x=X_ss[:, 0], y=X_ss[:, 1], hue=cluster_labels, palette="Set1")
plt.title(f"Make Blobs KMeans (k={optimal_k})")
plt.xlabel("Feature 1 (Standardized)")
plt.ylabel("Feature 2 (Standardized)")
plt.show()

# Display the original make_blobs data (optional, for comparison)
plt.figure(figsize=(8, 6))
plt.scatter(X[:, 0], X[:, 1], c=y)  # Plot original data with true labels
plt.title("Original Make Blobs Data")
plt.xlabel("Feature 1")
plt.ylabel("Feature 2")
plt.show()

from sklearn.cluster import DBSCAN
DB = DBSCAN(eps=0.4, min_samples=5)
DB.fit(X_ss)
plt.scatter(X_ss[:,0], X_ss[:,1], c=DB.labels_);
